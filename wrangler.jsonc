{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fragment-view",
  "send_metrics": false,
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-29",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": false },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "m43d4k.cloudflareaccess.com",
    "ACCESS_AUD": "dabf87f627f948b3ff13cb8a0303a53f084d94ece193092d4158280c2788eec6",
    "ALLOWED_EMAIL": "m43d4k@gmail.com"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "fragment-view",
    "database_id": "86e66984-44c1-4a3b-9144-4bbda4f6681a",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "fragment-view" }],
  "routes": [{ "pattern": "fragment.m43d4k.fyi", "custom_domain": true }],
  "env": {
    "local": {
      "vars": { "LOCAL_DEV": "true", "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "", "ALLOWED_EMAIL": "" },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "fragment-view-local",
        "database_id": "00000000-0000-0000-0000-000000000001",
        "migrations_dir": "migrations"
      }],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "fragment-view-local-assets" }]
    }
  }
}
